<jittershader name="vzbl.ganzgraf">
	<param name="amplitude" type="float" default="0.5" />
	<param name="phase"     type="float" default="0.0" />
	<param name="hue"       type="float" default="0.0" />
	<language name="glsl" version="1.0">
		<bind param="tex0"      program="fp" />
		<bind param="amplitude" program="fp" />
		<bind param="phase"     program="fp" />
		<bind param="hue"       program="fp" />
		<program name="vp" type="vertex"   source="vzbl.v001.scanlines.vp.glsl" />
		<program name="fp" type="fragment" source="vzbl.ganzgraf.fp.glsl" />
	</language>
</jittershader>
