<jittershader name="vzbl.slicr">
	<param name="amount"      type="float" default="0.0" />
	<param name="slices"      type="float" default="8.0" />
	<param name="phase"       type="float" default="0.0" />
	<param name="orientation" type="int"   default="0" />
	<language name="glsl" version="1.0">
		<bind param="tex0"        program="fp" />
		<bind param="amount"      program="fp" />
		<bind param="slices"      program="fp" />
		<bind param="phase"       program="fp" />
		<bind param="orientation" program="fp" />
		<program name="vp" type="vertex"   source="vzbl.v001.scanlines.vp.glsl" />
		<program name="fp" type="fragment" source="vzbl.slicr.fp.glsl" />
	</language>
</jittershader>
